{
  "name": "cv",
  "version": "1.0.0",
  "private": true,
  "author": "Alec Rust (https://www.alecrust.com/)",
  "packageManager": "npm@12.2.1",
  "scripts": {
    "dev": "npm run build && resume serve --resume src/resume.json --theme .",
    "build": "node build.js",
    "test": "playwright test",
    "lint": "biome ci . && stylelint '**/*.css'",
    "format": "biome check --write . && stylelint --fix '**/*.css'",
    "watch": "node build.js --watch",
    "validate-schema": "cd src && resume validate",
    "spellcheck": "cspell",
    "prepare": "husky"
  },
  "browserslist": [
    "defaults"
  ],
  "dependencies": {
    "date-fns": "^4.4.0",
    "normalize.css": "^8.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@playwright/test": "^1.64.1",
    "chokidar": "^6.0.0",
    "cspell": "^10.4.0",
    "cssnano": "^9.9.0",
    "fs-extra": "^11.4.1",
    "glob": "^13.0.6",
    "handlebars": "^4.7.10",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.31",
    "postcss-import": "^17.0.1",
    "postcss-preset-env": "^11.6.1",
    "resume-cli": "^3.8.3",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0"
  },
  "lint-staged": {
    "*": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true",
    "*.css": "stylelint --fix",
    "*.{md,hbs}": "cspell --no-must-find-files --no-summary --no-progress",
    "src/resume.json": "cspell --no-must-find-files --no-summary --no-progress"
  }
}
